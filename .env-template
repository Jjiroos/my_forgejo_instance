# Copier en .env puis remplir — le .env réel n'est jamais commité (.gitignore)
#   cp .env-template .env && chmod 600 .env

# Sous-domaine public DuckDNS (cf. SETUP.md §2) — sans le port
FORGEJO_DOMAIN=<SOUS_DOMAINE>.duckdns.org

# PostgreSQL — générer le mot de passe avec : openssl rand -base64 32
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=<MOT_DE_PASSE_GENERE>
