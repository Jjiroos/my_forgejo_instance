{% set s = nginx_site_defaults | combine(site, recursive=True) %}
# {{ ansible_managed }} — site « {{ s.name }} »
#
# Généré par le rôle nginx à partir de `nginx_sites`. Ne pas éditer sur la
# machine : la prochaine exécution écraserait la modification.
server {
    listen {{ s.listen.address }}:{{ s.listen.port }} ssl http2;
    server_name {{ s.domain }};

    ssl_certificate     {{ nginx_cert_dir }}/{{ s.cert }}.crt;
    ssl_certificate_key {{ nginx_cert_dir }}/{{ s.cert }}.key;
    ssl_protocols       {{ nginx_ssl_protocols }};
    ssl_ciphers         {{ nginx_ssl_ciphers }};

    access_log /var/log/nginx/{{ s.name }}-access.log;
    error_log  /var/log/nginx/{{ s.name }}-error.log;

{% if s.allow | length > 0 %}
    # Filtrage applicatif. Il double la règle UFW volontairement : un pare-feu
    # et une directive nginx ne tombent pas en panne pour les mêmes raisons.
{% for ip in s.allow %}
    allow {{ ip }};
{% endfor %}
    deny  all;

{% endif %}
    server_tokens off;
    client_max_body_size {{ s.client_max_body_size }};

    proxy_read_timeout      {{ s.proxy_timeout }};
    proxy_send_timeout      {{ s.proxy_timeout }};
{% if s.get('proxy_request_buffering_off', false) %}
    proxy_request_buffering off;
{% endif %}

    proxy_http_version 1.1;
{% if s.websockets %}
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        'upgrade';
    proxy_cache_bypass $http_upgrade;
{% endif %}
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

{% if s.hsts %}
    add_header Strict-Transport-Security "max-age=63072000" always;
{% endif %}
    add_header X-Frame-Options        {{ s.frame_options }} always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy        strict-origin-when-cross-origin always;

{% for loc in s.locations %}
    location {{ loc.path }} {
{% if loc.rate_limit is defined %}
        limit_req zone={{ loc.rate_limit.zone }} burst={{ loc.rate_limit.burst }} nodelay;
{% endif %}
        proxy_pass {{ loc.upstream | default(s.upstream) }};
    }

{% endfor %}
    location / {
        proxy_pass {{ s.upstream }};
    }
}
