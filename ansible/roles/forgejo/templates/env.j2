# {{ ansible_managed }}
#
# Lu par docker compose. Mode 0600 : ce fichier porte le mot de passe de la
# base et, lors d'une restauration, les clés de chiffrement de la forge.
POSTGRES_DB={{ forgejo_db_name }}
POSTGRES_USER={{ forgejo_db_user }}
POSTGRES_PASSWORD={{ forgejo_db_password }}
{% if forgejo_secret_key | length > 0 %}
FORGEJO_SECRET_KEY={{ forgejo_secret_key }}
{% endif %}
{% if forgejo_internal_token | length > 0 %}
FORGEJO_INTERNAL_TOKEN={{ forgejo_internal_token }}
{% endif %}
{% if forgejo_oauth2_jwt_secret | length > 0 %}
FORGEJO_OAUTH2_JWT_SECRET={{ forgejo_oauth2_jwt_secret }}
{% endif %}
{% if forgejo_lfs_jwt_secret | length > 0 %}
FORGEJO_LFS_JWT_SECRET={{ forgejo_lfs_jwt_secret }}
{% endif %}
