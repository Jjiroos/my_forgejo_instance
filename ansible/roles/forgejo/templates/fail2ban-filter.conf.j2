# {{ ansible_managed }}
#
# Filtre des échecs d'authentification de Forgejo. Les trois formulations sont
# celles que la documentation amont retient. Vérifié sur Forgejo 11, contre un
# journal produit pour l'occasion — mot de passe erroné et compte inexistant
# donnent tous deux, depuis routers/web/auth/auth.go :
#
#   [W] Failed authentication attempt for testeur from 198.51.100.7:0:
#       user's password is invalid [uid: 1, name: testeur]
#   [W] Failed authentication attempt for inconnu from 198.51.100.8:0:
#       user does not exist [uid: 0, name: inconnu]
#
# 2 lignes reconnues sur 39, aucun faux positif.
#
# CE QUE CE FILTRE NE COUVRE PAS. Un échec d'authentification sur /api/v1/ en
# basic auth ne produit aucune de ces lignes : seulement un « 401 Unauthorized »
# de routeur, rigoureusement identique à celui d'une requête anonyme légitime.
# Bannir là-dessus reviendrait à bannir quiconque interroge l'API sans jeton.
# La force brute sur mot de passe passe par le formulaire, et c'est lui qui est
# couvert ; un jeton d'API volé ne se défend pas par fail2ban mais par sa
# révocation.
#
# Ce filtre n'a de sens que si l'adresse journalisée est celle du client et
# non celle de nginx. C'est le cas ici sans réglage supplémentaire : le vhost
# transmet X-Forwarded-For, et Forgejo fait confiance par défaut aux mandataires
# de 127.0.0.0/8. Le jour où nginx déménagerait hors de l'hôte, il faudrait
# ajouter son adresse à REVERSE_PROXY_TRUSTED_PROXIES — sans quoi la jail
# bannirait le mandataire, c'est-à-dire tout le monde.
#
# Se vérifie sans attendre une attaque :
#   fail2ban-regex {{ forgejo_log_file }} /etc/fail2ban/filter.d/forgejo.conf
[Definition]
failregex = .*(Failed authentication attempt|invalid credentials|Attempted access of unknown user).* from <HOST>
ignoreregex =
