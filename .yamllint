# Configuration yamllint, consommée aussi par ansible-lint.
#
# Trois assouplissements d'espacement, tous pour la même raison : l'alignement
# des valeurs et les dictionnaires courts sur une ligne rendent un fichier de
# variables nettement plus lisible. Tout le reste est laissé aux valeurs par
# défaut, y compris l'exigence d'un `---` en tête de document.
extends: default

rules:
  braces:
    max-spaces-inside: 1      # autorise `{ nom: valeur }`
  colons:
    max-spaces-after: -1      # autorise `cle:      valeur` aligné
  commas:
    max-spaces-after: -1      # autorise `{ a: 1,    b: 2 }` aligné
  line-length: disable        # les commentaires explicatifs priment
  truthy:
    allowed-values: ["true", "false"]
